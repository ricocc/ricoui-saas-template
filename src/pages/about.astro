---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/elements/PageHeader.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import { siteConfig } from "@/config/site";
import { ArrowRight, Heart, Code, Users, GitBranch, GitFork } from "@lucide/astro";

const timeline = [
  {
    version: "v0.1",
    date: "2026 年 5 月",
    title: "第一版草图",
    desc: "最早只是一个副项目：做一个由设计师主导、但不那么模板味的 SaaS 模板。先从 Hero、三张功能卡和价格页开始。",
  },
  {
    version: "v0.2",
    date: "2026 年 5 月",
    title: "首次公开发布",
    desc: "9 个页面、15 个 section、暗黑模式、MDX Blog 和 Changelog。以 MIT 协议发布到 GitHub，第一批 fork 和 issue 帮助我们把模板打磨到可用状态。",
  },
  {
    version: "v0.3",
    date: "2026 年 5 月",
    title: "内容系统与视觉打磨",
    desc: "迁移到 Astro Content Layer API，优化暗黑模式对比度，减少冷启动构建时间，并抽出 BrowserFrame 作为复用组件。",
  },
  {
    version: "v1.0",
    date: "2026 年 5 月",
    title: "围绕产品故事重写",
    desc: "把示例内容重新收束到 RicoFast 这个虚拟品牌上，让演示站更像真实产品，而不是一组零散页面。",
  },
];
---

<Layout
  title="关于 — RicoFast"
  description="了解 RicoFast：一个基于 Astro 和 Tailwind CSS 的高质感 SaaS 模板。"
>
  <section class="site-container my-12">
    <PageHeader
      title="一个尽量不像模板的模板"
      description="为重视产品呈现方式的开发者和团队准备。MIT 开源协议，可以 fork、上线，也可以基于它做商业项目。"
    />
  </section>

  <section class="site-container max-w-3xl mx-auto pb-24">
    <article class="space-y-10">

      <!-- Why we built it -->
      <div data-aos="fade-up-xs" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">为什么做 RicoFast</h2>
        <div class="space-y-4 text-neutral-600 dark:text-neutral-300 leading-relaxed">
          <p>
            很多开源 SaaS 模板会落在两个极端：一种只是骨架，给你一个 Hero、三张功能卡和价格页，剩下的还得自己补；另一种堆满几十个 section、几套主题和复杂配置，看起来全面，真正落地时却要删掉一半。
          </p>
          <p>
            RicoFast 更适合创始人、独立开发者和早期团队。它提供真实 SaaS 官网常用的页面、15+ 可组合 section，以及一套写进文档的设计系统。你可以替换内容，但页面不会因为改了文案就失去整体感。
          </p>
          <p>
            我们选择 Astro，是因为营销站应该默认很快；选择 Tailwind v4，是因为 <code class="text-primary">@theme</code> 让品牌替换更直接。字体统一使用思源黑体，让中文正文、标题和 UI 保持一致。
          </p>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Values -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">我们在意什么</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Code class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">代码清楚</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">结构可读、便于维护，组件尽量遵循同一套写法。</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Users class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">体验优先</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">可访问性和可用性不是后补项。组件需要同时适配浅色和深色模式。</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <Heart class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">细节有判断</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">间距、排版和动效都应该有理由，而不是套默认值。</p>
          </div>
          <div class="p-5 rounded-xl bg-bg-secondary dark:bg-bg-secondary-dark border border-primary/10 dark:border-neutral-700">
            <GitBranch class="w-5 h-5 text-primary mb-3" />
            <h3 class="text-sm font-semibold text-neutral-800 dark:text-neutral-100 mb-1">默认开放</h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400">MIT 协议、无供应商绑定、无需署名。后续方向由真实使用场景推动。</p>
          </div>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Timeline -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-6">一路怎么走到现在</h2>
        <div class="relative">
          <div class="absolute left-3 md:left-4 top-1.5 bottom-1.5 w-px bg-neutral-200 dark:bg-neutral-700"></div>
          <ol class="space-y-8">
            {timeline.map((item, i) => (
              <li class="relative pl-10 md:pl-12" data-aos="fade-up-sm" data-aos-delay={i * 80} data-aos-once="true">
                <div class="absolute left-1.5 md:left-2.5 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-bg-primary dark:border-bg-primary-dark"></div>
                <div class="mb-1 flex items-center gap-3 flex-wrap">
                  <Badge variant="primary" size="sm">{item.version}</Badge>
                  <span class="text-xs text-neutral-400 dark:text-neutral-500">{item.date}</span>
                </div>
                <h3 class="text-base font-semibold text-neutral-800 dark:text-neutral-100 mb-1">{item.title}</h3>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">{item.desc}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="w-full border-b border-dashed border-neutral-200 dark:border-neutral-700"></div>

      <!-- Open source -->
      <div data-aos="fade-up-xs" data-aos-delay="100" data-aos-once="true">
        <h2 class="text-2xl font-brand text-neutral-800 dark:text-neutral-100 mb-4">开源</h2>
        <p class="text-neutral-600 dark:text-neutral-300 leading-relaxed mb-6">
          RicoFast 在 GitHub 上以 MIT 协议开源。你可以提交 issue、发 PR、提出功能建议。我们更关心真实项目里遇到的问题，而不是凭空堆功能。
        </p>
      </div>

      <div class="flex flex-wrap gap-4" data-aos="fade-up-xs" data-aos-delay="200" data-aos-once="true">
        <Button url={siteConfig.social.github} type="fill" target="_blank">
          <GitFork size={16} /> 在 GitHub 点 Star <ArrowRight size={16} />
        </Button>
        <Button url="/changelog">
          查看 Changelog
        </Button>
      </div>
    </article>
  </section>
</Layout>
